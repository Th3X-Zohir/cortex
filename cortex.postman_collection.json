{
	"info": {
		"name": "cortex",
		"description": "OpenAI-compatible AI proxy — Grok, Gemini, ChatGPT via headless browser",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:31339"
		},
		{
			"key": "apiKey",
			"value": "REPLACE_WITH_API_KEY"
		},
		{
			"key": "defaultPrompt",
			"value": "Say hello in 5 words"
		},
		{
			"key": "defaultTemp",
			"value": "0.7"
		},
		{
			"key": "defaultMaxTokens",
			"value": "150"
		},
		{
			"key": "adminUsername",
			"value": "admin"
		},
		{
			"key": "adminPassword",
			"value": "REPLACE_WITH_ADMIN_PASSWORD"
		},
		{
			"key": "adminToken",
			"value": "REPLACE_WITH_ADMIN_JWT"
		}
	],
	"auth": {
		"type": "apikey",
		"apikey": [
			{
				"key": "key",
				"value": "X-API-Key",
				"type": "string"
			},
			{
				"key": "value",
				"value": "{{apiKey}}",
				"type": "string"
			},
			{
				"key": "in",
				"value": "header",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Health",
			"request": {
